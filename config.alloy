logging {
  level  = "debug"
  format = "logfmt"
}

livedebugging {
  enabled = true
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = []
    traces  = []
  }
}

otelcol.processor.batch "default" {
  timeout = "5s"
  send_batch_max_size = 1024
  send_batch_size = 256
  output {
    // Forward batched metrics to Prometheus and to the debug exporter
    metrics = [otelcol.exporter.prometheus.default.input, otelcol.exporter.debug.metrics.input]
    logs    = []
    traces  = []
  }
}

// Debug exporter prints metrics to logs for troubleshooting
otelcol.exporter.debug "metrics" {}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
