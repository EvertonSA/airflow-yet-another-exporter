{
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "11.0.0"
        },
        {
            "type": "panel",
            "id": "stat",
            "name": "Stat",
            "version": ""
        },
        {
            "type": "panel",
            "id": "timeseries",
            "name": "Time series",
            "version": ""
        },
        {
            "type": "panel",
            "id": "bargauge",
            "name": "Bar gauge",
            "version": ""
        }
    ],
    "title": "Airflow Executive Report (Manager View)",
    "uid": "airflow-manager-report",
    "tags": [
        "airflow",
        "manager",
        "report",
        "long-term"
    ],
    "timezone": "browser",
    "editable": true,
    "weekStart": "monday",
    "refresh": "1h",
    "schemaVersion": 39,
    "style": "dark",
    "time": {
        "from": "now-7d",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "current": {
                    "text": "All",
                    "value": "$__all"
                },
                "definition": "label_values(airflow_dag_run_state, repository)",
                "hide": 0,
                "includeAll": true,
                "multi": true,
                "name": "repository",
                "options": [],
                "query": {
                    "query": "label_values(airflow_dag_run_state, repository)",
                    "refId": "StandardVariableQuery"
                },
                "refresh": 1,
                "regex": "",
                "skipUrlSync": false,
                "sort": 1,
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                }
            }
        ]
    },
    "panels": [
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "title": "Weekly Health Summary (Last 7 Days)",
            "type": "row",
            "collapsed": false
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "id": 2,
            "title": "Global Success Rate (SLO)",
            "description": "The percentage of DAG runs that ended in 'success' versus 'failed' over the selected time range. A healthy platform typically targets >95% or >99%.",
            "type": "stat",
            "targets": [
                {
                    "expr": "sum(delta(airflow_dag_run_state{state=\"success\", repository=~\"$repository\"}[$__range])) / (sum(delta(airflow_dag_run_state{state=\"success\", repository=~\"$repository\"}[$__range])) + sum(delta(airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"}[$__range]))) * 100",
                    "refId": "A",
                    "legendFormat": "Success Rate %"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 90
                            },
                            {
                                "color": "green",
                                "value": 98
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "id": 3,
            "title": "Total Completed Runs",
            "description": "Total volume of work (DAGs) completed (Success + Failed) in the selected period. Useful for tracking throughput growth week-over-week.",
            "type": "stat",
            "targets": [
                {
                    "expr": "sum(delta(airflow_dag_run_state{state=~\"success|failed\", repository=~\"$repository\"}[$__range]))",
                    "refId": "A",
                    "legendFormat": "Total Runs"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "blue"
                    }
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "id": 4,
            "title": "Total Failures",
            "description": "Absolute count of failed DAG runs. SLO Breaches. Keep this number as close to zero as possible.",
            "type": "stat",
            "targets": [
                {
                    "expr": "sum(delta(airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"}[$__range]))",
                    "refId": "A",
                    "legendFormat": "Failures"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 7
            },
            "id": 5,
            "title": "Stability & Reliability Trends",
            "type": "row",
            "collapsed": false
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "id": 6,
            "title": "Daily Failure Volume",
            "description": "Bar chart showing how many failures occurred each day. Look for patterns (e.g., 'Mondays are bad').",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (repository) (delta(airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"}[24h]))",
                    "refId": "A",
                    "legendFormat": "{{repository}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "stacking": {
                            "mode": "normal"
                        }
                    },
                    "unit": "short"
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "id": 7,
            "title": "Average System Latency (Trend)",
            "description": "How long DAGs take to complete on average. A rising line means the platform is getting slower week-over-week.",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "avg(airflow_dag_run_duration_avg_24h{repository=~\"$repository\"})",
                    "refId": "A",
                    "legendFormat": "Global Avg Duration"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "yellow"
                    }
                }
            }
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "id": 8,
            "title": "Outliers & Bottlenecks",
            "type": "row",
            "collapsed": false
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 17
            },
            "id": 9,
            "title": "Most Unstable Repositories (Failures)",
            "description": "Ranking of repositories by total failure count in the selected period. These are your 'Problem Children' that need refactoring.",
            "type": "bargauge",
            "targets": [
                {
                    "expr": "topk(10, sum by (repository) (delta(airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"}[$__range])))",
                    "refId": "A",
                    "legendFormat": "{{repository}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "continuous-GrYlRd"
                    }
                },
                "overrides": []
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "showUnfilled": true
            }
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 17
            },
            "id": 10,
            "title": "Slowest Repositories (Avg Duration)",
            "description": "Ranking of repositories by how long they take to run. Identify who is hogging resources or running inefficiently.",
            "type": "bargauge",
            "targets": [
                {
                    "expr": "topk(10, max by (repository) (airflow_dag_run_duration_avg_24h{repository=~\"$repository\"}))",
                    "refId": "A",
                    "legendFormat": "{{repository}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "scaleDistribution": {
                            "type": "log",
                            "log": 2
                        }
                    },
                    "color": {
                        "mode": "continuous-BlPu"
                    }
                }
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "showUnfilled": true
            }
        }
    ]
}