{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "title": "Airflow 3.0 Observability (SRE)",
  "uid": "airflow-sre-dashboard",
  "tags": [
    "airflow",
    "sre",
    "exporter"
  ],
  "timezone": "browser",
  "editable": true,
  "weekStart": "monday",
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "templating": {
    "list": [
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(airflow_dag_run_state, repository)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "repository",
        "options": [],
        "query": {
          "query": "label_values(airflow_dag_run_state, repository)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 99,
      "title": "Exporter Health & Reliability",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "airflow_exporter_up",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Exporter Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "rate(airflow_exporter_scrape_duration_seconds_sum[1m]) / rate(airflow_exporter_scrape_duration_seconds_count[1m])",
          "refId": "A",
          "legendFormat": "Avg Scrape Latency"
        }
      ],
      "title": "Scrape Latency (Avg)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum(airflow_dag_run_state{state=\"running\"})",
          "refId": "A"
        }
      ],
      "title": "Total Running DAGs (Global)",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 98,
      "title": "Key Indicators (Golden Signals)",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (state) (airflow_dag_run_state{repository=~\"$repository\"})",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "title": "Global DAG Run States",
      "type": "piechart",
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (state) (airflow_task_instance_state{repository=~\"$repository\"})",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "title": "Global Task Instance States",
      "type": "piechart",
      "options": {
        "pieType": "donut"
      }
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 97,
      "title": "Failure Analysis & Performance",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 5,
      "targets": [
        {
          "expr": "topk(10, sum by (operator) (airflow_task_operator_failures{repository=~\"$repository\"}))",
          "refId": "A",
          "legendFormat": "{{operator}}"
        }
      ],
      "title": "Top 10 Failing Operator Types",
      "type": "barchart",
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 6,
      "targets": [
        {
          "expr": "topk(10, max by (repository) (airflow_dag_run_duration_avg_24h{repository=~\"$repository\"}))",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "title": "Longest Running Repositories (Avg 24h)",
      "type": "barchart",
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 96,
      "title": "Detailed Breakdown",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 7,
      "title": "Repository Statistics",
      "type": "table",
      "targets": [
        {
          "expr": "sum by (repository) (airflow_dag_run_state{state=\"running\", repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Running Executions",
          "refId": "A"
        },
        {
          "expr": "sum by (repository) (airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Failed DAGs",
          "refId": "B"
        },
        {
          "expr": "sum by (repository) (airflow_task_operator_failures{repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Total Task Failures",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "repository",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Running Executions",
              "Value #B": "Failed DAGs",
              "Value #C": "Task Failures"
            }
          }
        }
      ]
    }
  ]
}
```