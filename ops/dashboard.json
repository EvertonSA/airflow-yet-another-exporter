{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "title": "Airflow 3.0 Observability (SRE)",
  "uid": "airflow-sre-dashboard",
  "tags": [
    "airflow",
    "sre",
    "exporter"
  ],
  "timezone": "browser",
  "editable": true,
  "weekStart": "monday",
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "templating": {
    "list": [
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(airflow_dag_run_state, repository)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "repository",
        "options": [],
        "query": {
          "query": "label_values(airflow_dag_run_state, repository)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 99,
      "title": "Exporter Health & Reliability",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "airflow_exporter_up",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Exporter Status",
      "description": "Indicates if the exporter is successfully scraping the Airflow database. RED (Down) means metrics are stale and no new data is being collected.",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "rate(airflow_exporter_scrape_duration_seconds_sum[1m]) / rate(airflow_exporter_scrape_duration_seconds_count[1m])",
          "refId": "A",
          "legendFormat": "Avg Scrape Latency"
        }
      ],
      "title": "Scrape Latency (Avg)",
      "description": "Average time taken to query the Airflow database. High latency (>5s) suggests database load issues or inefficient queries.",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum(airflow_dag_run_state{state=\"running\"})",
          "refId": "A"
        }
      ],
      "title": "Total Running DAGs (Global)",
      "description": "The absolute number of DAGs currently executing across the entire system. Use this to gauge overall platform concurrency.",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 10,
      "targets": [
        {
          "expr": "increase(airflow_exporter_scrape_duration_seconds_count[1h])",
          "refId": "A",
          "legendFormat": "Scrapes/h"
        }
      ],
      "title": "Scrapes per Hour",
      "description": "Rate of successful data collections. A drop represents intermittent availability or connectivity issues.",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 98,
      "title": "Key Indicators (Golden Signals)",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 2
            }
          }
        }
      },
      "targets": [
        {
          "expr": "max by (repository) (airflow_dag_run_duration_avg_24h)",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "title": "Latency (Max Avg Duration)",
      "description": "GOLDEN SIGNAL: LATENCY. The average wall-clock time DAGs take to complete (last 24h). Rising trends indicate performance degradation or data delivery delays.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (repository) (airflow_task_instance_state{state=\"running\"})",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "title": "Traffic (Concurrency)",
      "description": "GOLDEN SIGNAL: TRAFFIC. The number of active tasks running right now per repository. Shows which repositories are consuming your slot capacity.",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "id": 13,
      "targets": [
        {
          "expr": "sum by (repository) (delta(airflow_task_operator_failures{repository=~\"$repository\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "title": "Errors (Total Failures in Range)",
      "description": "GOLDEN SIGNAL: ERRORS. The total count of task failures over the selected time range. Spikes usually indicate broken code, bad data, or external system outages.",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "id": 14,
      "targets": [
        {
          "expr": "sum by (repository) (airflow_task_instance_state{state=\"queued\"})",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "title": "Saturation (Queue Depth)",
      "description": "GOLDEN SIGNAL: SATURATION. The number of tasks in 'queued' state waiting for a worker slot. Persistent queue depth means you need more workers or concurrency slots.",
      "type": "timeseries"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 97,
      "title": "Failure Analysis & Performance",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 5,
      "targets": [
        {
          "expr": "topk(10, sum by (operator) (airflow_task_operator_failures{repository=~\"$repository\"}))",
          "refId": "A",
          "legendFormat": "{{operator}}",
          "instant": true
        }
      ],
      "title": "Top 10 Failing Operator Types",
      "description": "Breakdown of failures by task type (e.g., Python, Bash, Sensor). Helps identify if a specific subsystem (like Kubernetes or a generic script) is the root cause.",
      "type": "bargauge",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 6,
      "targets": [
        {
          "expr": "topk(10, max by (repository) (airflow_dag_run_duration_avg_24h{repository=~\"$repository\"}))",
          "refId": "A",
          "legendFormat": "{{repository}}",
          "instant": true
        }
      ],
      "title": "Longest Running Repositories (Avg 24h)",
      "description": "Ranking of slow repositories. Unlike the graph, this quickly identifies the absolute slowest workflows in your system.",
      "type": "bargauge",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 100,
      "title": "Task Performance (24h Avg)",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 15,
      "targets": [
        {
          "expr": "max by (repository) (airflow_task_duration_avg_24h)",
          "legendFormat": "{{repository}}",
          "refId": "A"
        }
      ],
      "title": "Avg Task Duration (24h)",
      "description": "Pure Execution Time (24h Average). The average time tasks of this repository spent actually running (execution state) over the last 24 hours. Increases here indicate the code is slow or data volume has increased.",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 16,
      "targets": [
        {
          "expr": "max by (repository) (airflow_task_queue_wait_duration_avg_24h)",
          "legendFormat": "{{repository}}",
          "refId": "A"
        }
      ],
      "title": "Avg Queue Wait Time (24h)",
      "description": "Infrastructure Wait Time (24h Average). The average time tasks of this repository waited for a slot over the last 24 hours. Increases here indicate infrastructure starvation (not enough workers).",
      "type": "timeseries"
    },
    {
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 96,
      "title": "Detailed Breakdown",
      "type": "row",
      "collapsed": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 7,
      "title": "Repository Statistics",
      "type": "table",
      "targets": [
        {
          "expr": "sum by (repository) (airflow_dag_run_state{state=\"running\", repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Running Executions",
          "refId": "A"
        },
        {
          "expr": "sum by (repository) (airflow_dag_run_state{state=\"failed\", repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Failed DAGs",
          "refId": "B"
        },
        {
          "expr": "sum by (repository) (airflow_task_operator_failures{repository=~\"$repository\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Total Task Failures",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "repository",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Running Executions",
              "Value #B": "Failed DAGs",
              "Value #C": "Task Failures"
            }
          }
        }
      ]
    }
  ]
}